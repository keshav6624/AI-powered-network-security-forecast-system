# NetGuard AI - .gitignore
# SIH26153 - AI-Powered Network Attack Forecasting System

# Environment
.env
.env.local
.env.*.local

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
.venv/
env/
ENV/
pip-log.txt
pip-delete-this-directory.txt
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Node
node_modules/
dist/
build/
.cache/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Datasets - DO NOT COMMIT
*.csv
*.parquet
*.pkl
*.h5
*.hdf5
data/raw/
data/processed/*.csv
data/processed/*.parquet

# Models - large artifacts (keep structure, ignore binaries unless intentionally tracked)
models/**/*.pkl
models/**/*.pt
models/**/*.pth
models/**/*.json
models/**/*.onnx
# Keep directory structure with .gitkeep, allow config.json examples
!models/**/.gitkeep
!models/**/config.example.json

# Allowlist for small committed artifacts (uncomment when models are deliberately versioned)
# !models/baseline/*.pkl
# !models/preprocessing/*.json

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
desktop.ini

# Docker
.docker/

# Logs
logs/
*.log

# Experiments / Notebooks outputs
experiments/outputs/
notebooks/.ipynb_checkpoints/

# Database
*.db
*.sqlite
pgdata/
