# NetGuard AI - Root Environment Template
# SIH26153 - AI-Powered Network Attack Forecasting System
# Copy to .env and fill values. NEVER commit .env

APP_ENV=development
DEMO_MODE=true
LOG_LEVEL=INFO

# Database (PostgreSQL)
DATABASE_URL=postgresql://netguard:netguard_secret@postgres:5432/netguard
POSTGRES_USER=netguard
POSTGRES_PASSWORD=netguard_secret
POSTGRES_DB=netguard
POSTGRES_PORT=5432

# Backend
BACKEND_PORT=8000
BACKEND_HOST=0.0.0.0

# Frontend
FRONTEND_PORT=3000
VITE_API_BASE_URL=http://localhost:8000

# Models
MODEL_DIR=./models
PREPROCESSING_DIR=./models/preprocessing

# Replay
REPLAY_DEFAULT_SPEED=1
REPLAY_SAMPLE_PATH=./data/sample

# Security
SECRET_KEY=change-me-in-production
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
